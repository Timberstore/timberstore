# Server only. Never commit real values or copy them into TIMBER_* variables.
SHOPTET_ACCESS_TOKEN=
SHOPTET_PRIVATE_API_TOKEN=
# Keep disabled until /api/stocks IDs, sales units and amount/claim semantics
# have been checked against a real order/reservation on project 765909.
SHOPTET_STOCK_VERIFIED=0
# No default: available OR physical-minus-claim after verification only.
SHOPTET_STOCK_AMOUNT_MODE=
# Only IDs read from actual named warehouse records; must agree with Dolný Hričov / Centrálny sklad.
SHOPTET_HRICOV_STOCK_ID=
SHOPTET_CSNK_STOCK_ID=
STOCK_ALLOWED_ORIGIN=https://www.timberstore.sk
STOCK_BIND=127.0.0.1
STOCK_PORT=8787

# Optional, read-only alternative if native Shoptet only exposes aggregate ext.
# Set api OR export after selecting an actual source; default remains api.
STOCK_SOURCE=api
# Server secret: protected URL from Products > Export > Export via URL.
SHOPTET_EXPORT_URL=
# Keep disabled until an actual export matches admin available stock and units.
SHOPTET_EXPORT_VERIFIED=0
# CSV must already contain available-to-order amounts; never subtract claims twice.
SHOPTET_EXPORT_AMOUNT_MODE=
# One shared export every 60..300 seconds; default five minutes, validate source load first.
SHOPTET_EXPORT_REFRESH_SECONDS=300
SHOPTET_EXPORT_ENCODING=utf-8
SHOPTET_EXPORT_DELIMITER=;
# Actual headers, not warehouse IDs. Adjust exact spelling only after inspecting a real CSV.
SHOPTET_EXPORT_HRICOV_COLUMN=stock:Dolný Hričov
SHOPTET_EXPORT_CSNK_COLUMN=stock:Centrálny sklad
